---
import Shell from "../layouts/Shell.astro";
import { brand } from "../brand";
import ThemeToggle from "../layouts/ThemeToggle.astro";
export const prerender = true;
---
<Shell title="Your library" page="library-page">
  <header class="masthead">
    <a class="wordmark" href="/library/"><img src="/icon.svg" width="35" height="35" alt="" /><span>{brand}</span></a>
    <div class="masthead-actions">
      <a id="admin-link" class="logout-button" href="/admin/" hidden>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z" /></svg>
        <span class="logout-text">Admin</span>
      </a>
      <ThemeToggle />
      <button id="lang" class="logout-button lang-toggle" type="button"><span data-lang="en">EN</span><span aria-hidden="true">/</span><span data-lang="id">ID</span></button>
      <button id="large-ui" class="logout-button" type="button" aria-pressed="false" title="Larger text and buttons"><span aria-hidden="true" class="large-icon">A<span>A</span></span> <span class="large-text">Large text</span></button>
      <button id="logout" class="logout-button" type="button">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5m5 5H3m9-8h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-7" /></svg>
        <span class="logout-text">Sign out</span>
      </button>
    </div>
  </header>
  <main class="shelf">
    <div class="shelf-head">
      <div><p class="eyebrow shelf-label">Private collection</p><h1>Your library</h1><p class="muted">Pick up where you left off or open something new.</p></div>
      <button id="import" class="primary" type="button" disabled>Import PDF</button>
      <input id="file" type="file" accept="application/pdf,.pdf" hidden />
    </div>
    <aside id="install" class="install-banner" aria-labelledby="install-title" hidden>
      <img src="/icon-192.png" width="44" height="44" alt="" />
      <div><strong id="install-title">Add Pagekeepers to your home screen</strong><p id="install-text" class="muted"></p></div>
      <div class="install-actions">
        <button id="install-action" class="primary" type="button" hidden>Install</button>
        <button id="install-close" type="button" aria-label="Not now" title="Not now"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
      </div>
    </aside>
    <p id="status" role="status" class="notice">Loading your library…</p>
    <div id="transfer" class="transfer" hidden>
      <div><strong id="transfer-title"></strong><p id="transfer-text" class="muted"></p><progress id="transfer-progress" max="100" aria-label="Download progress"></progress></div>
      <button id="cancel" type="button">Cancel</button>
    </div>
    <section id="continue-section" class="shelf-section" aria-labelledby="continue-heading" hidden>
      <h2 id="continue-heading">Continue reading</h2>
      <div id="continue-book"></div>
    </section>
    <section id="habit" class="shelf-section habit" aria-labelledby="habit-heading" hidden>
      <h2 id="habit-heading">Reading habit</h2>
      <div class="habit-grid">
        <div class="habit-today">
          <p class="habit-figure"><strong id="habit-today"></strong> <span id="habit-goal"></span></p>
          <progress id="habit-progress" aria-label="Today's reading goal"></progress>
          <p id="habit-streak" class="muted"></p>
          <details class="goal-form">
            <summary>Change daily goal</summary>
            <form id="goal-form">
              <label>Minutes a day <input id="goal" type="number" inputmode="numeric" min="1" max="600" required /></label>
              <button type="submit">Save</button>
            </form>
          </details>
        </div>
        <div>
          <ol id="habit-calendar" class="habit-calendar" aria-label="Reading in the last five weeks"></ol>
          <ul class="habit-legend" aria-label="Calendar colors">
            <li><i class="level-1"></i>Under 1 hour</li><li><i class="level-2"></i>1–2 hours</li><li><i class="level-3"></i>2 hours or more</li>
          </ul>
          <p id="habit-week" class="muted"></p>
        </div>
      </div>
    </section>
    <section id="recent-section" class="shelf-section" aria-labelledby="recent-heading" hidden>
      <h2 id="recent-heading">Recently read</h2>
      <div id="recent-books" class="recent-books"></div>
    </section>
    <section class="shelf-section" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading">All books <span id="book-count"></span></h2>
      <form id="shelf-tools" class="shelf-tools" role="search" hidden>
        <label class="shelf-search"><span class="visually-hidden">Search by title</span><input id="search" type="search" placeholder="Search by title" autocomplete="off" enterkeyhint="search" /></label>
        <label><span class="visually-hidden">Show</span><select id="filter">
          <option value="all">All books</option><option value="reading">Reading</option><option value="unread">Not started</option><option value="finished">Finished</option><option value="saved">On this device</option>
        </select></label>
        <label><span class="visually-hidden">Sort by</span><select id="sort">
          <option value="recent">Recently read</option><option value="title">Title A–Z</option><option value="progress">Most progress</option>
        </select></label>
      </form>
      <p id="no-match" class="muted" hidden>No books match. Try another title or filter.</p>
      <div id="books" class="books"></div>
    </section>
  </main>
  <script is:inline type="module" src="/client/library.js"></script>
</Shell>
