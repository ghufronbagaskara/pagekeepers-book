---
import Shell from "../layouts/Shell.astro";
import { brand } from "../brand";
export const prerender = true;
---
<Shell title="Rak buku" page="library-page">
  <header class="masthead">
    <a class="wordmark" href="/library/"><img src="/icon.svg" width="35" height="35" alt="" /><span>{brand}</span></a>
    <div class="masthead-actions">
    <button id="large-ui" class="logout-button" type="button" aria-pressed="false" title="Teks dan tombol besar"><span aria-hidden="true" class="large-icon">A<span>A</span></span> <span class="large-text">Teks besar</span></button>
    <button id="logout" class="logout-button" type="button">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5m5 5H3m9-8h7a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-7" /></svg>
      Keluar
    </button>
    </div>
  </header>
  <main class="shelf">
    <div class="shelf-head">
      <div><p class="eyebrow shelf-label">Koleksi pribadi</p><h1>Rak buku</h1><p class="muted">Lanjutkan bacaan terakhir atau buka buku baru.</p></div>
      <button id="import" class="primary" type="button" disabled>Impor PDF</button>
      <input id="file" type="file" accept="application/pdf,.pdf" hidden />
    </div>
    <p id="status" role="status" class="notice">Memuat rak buku…</p>
    <div id="transfer" class="transfer" hidden>
      <div><strong id="transfer-title"></strong><p id="transfer-text" class="muted"></p><progress id="transfer-progress" max="100" aria-label="Kemajuan unduhan"></progress></div>
      <button id="cancel" type="button">Batal</button>
    </div>
    <section id="continue-section" class="shelf-section" aria-labelledby="continue-heading" hidden>
      <h2 id="continue-heading">Lanjut membaca</h2>
      <div id="continue-book"></div>
    </section>
    <section id="habit" class="shelf-section habit" aria-labelledby="habit-heading" hidden>
      <h2 id="habit-heading">Kebiasaan membaca</h2>
      <div class="habit-grid">
        <div class="habit-today">
          <p class="habit-figure"><strong id="habit-today"></strong> <span id="habit-goal"></span></p>
          <progress id="habit-progress" aria-label="Target membaca hari ini"></progress>
          <p id="habit-streak" class="muted"></p>
          <details class="goal-form">
            <summary>Ubah target harian</summary>
            <form id="goal-form">
              <label>Menit per hari <input id="goal" type="number" inputmode="numeric" min="1" max="600" required /></label>
              <button type="submit">Simpan</button>
            </form>
          </details>
        </div>
        <div>
          <ol id="habit-calendar" class="habit-calendar" aria-label="Riwayat membaca lima minggu terakhir"></ol>
          <p id="habit-week" class="muted"></p>
        </div>
      </div>
    </section>
    <section id="recent-section" class="shelf-section" aria-labelledby="recent-heading" hidden>
      <h2 id="recent-heading">Baru dibaca</h2>
      <div id="recent-books" class="recent-books"></div>
    </section>
    <section class="shelf-section" aria-labelledby="catalog-heading">
      <h2 id="catalog-heading">Semua buku <span id="book-count"></span></h2>
      <div id="books" class="books"></div>
    </section>
  </main>
  <script is:inline type="module" src="/client/library.js"></script>
</Shell>
