---
import Shell from "../layouts/Shell.astro";
import { brand } from "../brand";
export const prerender = true;
---
<Shell title="Masuk" page="login-page">
  <main class="login-layout">
    <div class="login-intro">
      <div class="wordmark"><img src="/icon.svg" width="37" height="37" alt="" /><span>{brand}</span></div>
      <p class="eyebrow">Perpustakaan pribadi</p>
      <p class="login-tagline">Satu halaman <br />lagi.</p>
      <p class="login-intro-copy">Tempat untuk buku yang Anda sukai dan buku yang akan Anda baca berikutnya.</p>
      <div class="login-illustration" aria-hidden="true">
        <div class="login-volume"><img src="/icon.svg" width="56" height="56" alt="" /></div>
      </div>
    </div>
    <section class="login-card" aria-labelledby="login-title">
      <h1 id="login-title">Selamat datang kembali</h1>
      <p class="muted">Masuk untuk kembali ke rak buku Anda.</p>
      <form>
        <label>Email <input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
        <label>Kata sandi <input name="password" type="password" autocomplete="current-password" required maxlength="128" /></label>
        <button class="primary">Masuk <span aria-hidden="true">→</span></button>
        <p id="status" role="status" class="notice"></p>
      </form>
    </section>
  </main>
  <script is:inline type="module" src="/client/login.js"></script>
</Shell>
