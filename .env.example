# Catalog uploads use the R2 S3 API. The account ID is part of its endpoint.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Used by Wrangler for D1 publishing and by non-interactive Alchemy deployments.
# Leave unset during interactive Alchemy deployment to use the OAuth profile.
CLOUDFLARE_API_TOKEN=
